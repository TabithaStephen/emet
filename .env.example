# Copy this file to .env.local and fill in your key.
#   cp .env.example .env.local
#
# .env.local is gitignored and must never be committed.

# Required for the AI audit. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Defaults to gemini-3.5-flash-lite — Google's "fastest, most
# cost-effective 3.5 model", and it defaults to MINIMAL thinking.
#   gemini-3.5-flash-lite  fastest; the default
#   gemini-3.8-flash       more capable but thinks at MEDIUM by default (slow)
#   gemini-4-hydrogen      highest quality, slowest
# Do NOT use gemini-2.5-flash: deprecated, auto-routes elsewhere from 1 Dec 2026.
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional. Thinking level: MINIMAL, LOW, MEDIUM, HIGH or XHIGH.
# This is the correct control for Gemini 3.x and 4 — thinkingBudget is ignored
# by those models. Left unset the code picks MINIMAL, or LOW for the
# gemini-3.6/3.8-flash family, which reject MINIMAL.
# Raise it if the AI misses nuanced claims; it costs latency.
# GEMINI_THINKING_LEVEL=MINIMAL

# Optional. Hard ceiling for one text audit, in milliseconds. Default 45000.
# Past this the request is abandoned and you get a clear timeout error.
# Keep it below the route's maxDuration (60s) so our error fires, not the host's.
GEMINI_TIMEOUT_MS=45000

# Optional. Same, for the image comparison. Default 50000.
GEMINI_VISUAL_TIMEOUT_MS=50000

# --- Brand document import (PDF) -------------------------------------------
# Optional. The model used to read uploaded brand guideline PDFs.
# Falls back to GEMINI_MODEL, then gemini-3.5-flash-lite.
# Verified: gemini-3.5-flash-lite reads inline PDFs, including scanned ones.
# Set this only if your GEMINI_MODEL cannot accept document input.
# GEMINI_DOC_MODEL=gemini-3.5-flash-lite

# Optional. Milliseconds before a document read is abandoned. Default 50000.
# Must stay below the route's maxDuration (60s).
# GEMINI_DOC_TIMEOUT_MS=50000
